{
  // ============================================================
  // SOCIÉTÉ — paramètres des groupes et de la gouvernance émergente.
  // Aucun seuil de population n'est imposé : un campement devient
  // village par la sédentarisation décidée, pas par un cap.
  // ============================================================

  // Nombre de bandes initiales au démarrage (tirage entre min et max, configurable aussi par le joueur).
  "bandesInitialesMin": 1,
  "bandesInitialesMax": 5,

  // Taille d'une bande initiale, en nombre d'individus (tirage entre min et max).
  "tailleBandeInitialeMin": 8,
  "tailleBandeInitialeMax": 25,

  // Politiques paramétrées dont dispose un dirigeant (liste extensible, jamais un script).
  "politiquesDisponibles": [
    "repartitionTravail",
    "prelevements",
    "autorisationMigration",
    "reservesCommunes"
  ],

  // Rayon d'activité autour du campement pour le calcul du territoire émergent, en tuiles.
  "rayonTerritoireDefautTuiles": 12,

  // Probabilité qu'un individu suive un dirigeant charismatique lors d'une décision collective, par point de charisme au-dessus de la moyenne (0 à 1).
  "suiviParCharisme": 0.004,

  // Seuil de mécontentement (bonheur moyen du groupe sous cette valeur) qui pousse à la contestation, 0 à 100.
  "seuilMecontentementGroupe": 30,

  // Stock de nourriture au-delà duquel le groupe fait construire un grenier, en unités.
  "seuilStockNourriturePourGrenier": 120,

  // Capacité de stockage sans grenier (fond de hutte), en unités de nourriture.
  "capaciteStockSansGrenier": 25,

  // Nombre de huttes permanentes posées à partir duquel une bande est considérée comme sédentarisée (village). Ce n'est pas un seuil de population.
  "nbHuttesPourSedentarisation": 1,

  // Âge au-delà duquel un dirigeant cède sa place, en années.
  "ageMaxDirigeantAnnees": 80,

  // Poids de l'âge et du charisme dans le choix du dirigeant (influence émergente : les autres suivent).
  "poidsAgeDirigeant": 0.5,
  "poidsCharismeDirigeant": 0.5,

  // Rayon d'activité ajouté autour des bâtiments pour le calcul du territoire, en tuiles.
  "rayonTerritoireBatimentsTuiles": 4,

  // Intelligence (0 à 100) à partir de laquelle un individu peut être un génie inventeur.
  "seuilIntelligenceGenie": 78,

  // Probabilité de percée technologique par mois et par génie potentiel (modulée par l'intelligence), 0 à 1. Calibré au banc pour ~20 h de zéro à l'ère moderne.
  "chancePerceeParMois": 0.11,

  // Probabilité de transmission d'un savoir d'un maître à un élève proche, par mois, 0 à 1.
  "tauxTransmissionMaitreParMois": 0.3,

  // Probabilité de transmission passive d'un savoir à tout le groupe quand l'écriture est maîtrisée, par mois, 0 à 1.
  "tauxTransmissionEcritureParMois": 0.05,

  // Probabilité de transmission accélérée par école (bâtiment + savoir écriture), par mois, 0 à 1.
  "tauxTransmissionEcoleParMois": 0.5,

  // Quantité extraite d'un gisement par mois et par mine, en unités de ressource (le gisement s'épuise réellement).
  "extractionParMoisParMine": 10,

  // Taille du territoire (en tuiles d'activité) à partir de laquelle un village devient une nation.
  "seuilTerritoireNationTuiles": 120,

  // Pollution ajoutée par mois autour de chaque bâtiment polluant (mine, forge, centrale, raffinerie), 0 à 1.
  "pollutionParMoisParBatimentPolluant": 0.05,

  // Niveau de pollution d'une tuile au-delà duquel la santé des individus baisse.
  "seuilPollutionSante": 0.3,

  // Perte de santé par mois d'un individu sur une tuile polluée au-delà du seuil, en points.
  "perteSantePollutionParMois": 4,

  // Perte de biomasse de végétation par mois sur une tuile polluée au-delà du seuil.
  "perteBiomassePollutionParMois": 5,

  // Charbon consommé par mois par une centrale à charbon (si le stock est vide, la centrale s'arrête), en unités.
  "consommationCharbonCentraleParMois": 20,

  // Probabilité de frappe de monnaie (pièces) par mois quand la monnaie métallique est maîtrisée et une forge/banque existe, 0 à 1.
  "chanceFrappeMonnaieParMois": 0.5,

  // Rayon de recherche d'un gisement autour du camp pour y poser une mine, en tuiles.
  "rayonRechercheGisementTuiles": 60,

  // Bonheur sous lequel un individu peut décider de quitter son groupe (départ individuel), 0 à 100.
  "seuilBonheurDepart": 35,

  // Probabilité de départ individuel par mois quand le seuil de bonheur est franchi, 0 à 1.
  "chanceDepartIndividuelParMois": 0.05,

  // Probabilité de schisme collectif par mois quand le bonheur moyen du groupe est sous le seuil de mécontentement, 0 à 1.
  "chanceSchismeParMois": 0.03,

  // Biomasse moyenne du territoire sous laquelle un groupe envisage une migration collective, 0 à biomasse max.
  "seuilBiomasseMigration": 15,

  // Rayon de recherche d'une nouvelle terre pour une migration collective, en tuiles.
  "porteeRechercheNouvelleTerreTuiles": 120,

  // Probabilité de naufrage par mois pour un bateau en mer, 0 à 1.
  "chanceNaufrageParMois": 0.02,

  // Fraction des stocks communs prélevée chaque mois par le dirigeant quand la politique 'prelevements' est active (0 à 1), vers sa réserve (financement des chantiers).
  "prelevementPourcentReserve": 0.1,

  // Montant de prélèvement à partir duquel un événement est consigné au journal, en unités.
  "seuilJournalPrelevement": 20
}
