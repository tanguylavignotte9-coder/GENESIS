{
  "name": "genesis",
  "version": "0.1.0",
  "description": "Genesis — simulateur de civilisation humaine profonde, pixel art vu de haut. V1 : monde vivant sans guerre, joueur pur observateur.",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
