{
  // ============================================================
  // ÉCONOMIE — constantes de valeur, de périssabilité et d'échange.
  // La valeur est subjective par défaut (évaluée par chaque
  // individu) ; aucun prix global ni table figée.
  // ============================================================

  // Valeur subjective de base d'un bien (ancrage initial avant émergence des repères communs).
  "valeurSubjectiveBase": 10,

  // Durée de conservation des aliments avant dégradation, en jours de jeu, selon leur type.
  // Constantes biologiques : la viande se dégrade vite, le grain lent.
  "perissabiliteJours": {
    "viande": 10,
    "recolte": 60,
    "cueillette": 15,
    "grain": 180,
    "fume": 120,
    "fermente": 240
  },

  // Multiplicateur de conservation apporté par le fumoir.
  "multiplicateurConservationFumoir": 4,

  // Multiplicateur de conservation apporté par la fermentation.
  "multiplicateurConservationFermentation": 6,

  // Seuil de négociation d'un échange : écart minimal de valeur subjective perçu entre les deux biens (0 à 100).
  "seuilEcartValeurPourEchange": 1,

  // Portée d'un marché (rayon d'attraction des échanges formalisés), en tuiles.
  "porteeMarcheTuiles": 20,

  // Valeur subjective de base par type d'objet fabriquable (avant usure et besoin du moment).
  "valeurBaseObjets": {
    "hache": 15,
    "silex": 8,
    "houe": 12,
    "poterie": 10,
    "panier": 6,
    "outre": 9,
    "vetement": 14,
    "bijou": 30,
    "piece": 5,
    "biere": 8,
    "vin": 9,
    "hydromel": 7
  },

  // Probabilité qu'un groupe qui maîtrise la fermentation fabrique une boisson par mois, 0 à 1.
  "chanceFermentationParMois": 0.4,

  // Probabilité qu'un membre d'un groupe consomme une boisson fermentée par mois (fête), 0 à 1.
  "chanceConsommationFermenteParMois": 0.1,

  // Valeur d'une pièce de monnaie frappée (objet physique réel, possédé, transporté, volable).
  "valeurPiece": 5,

  // Probabilité de fabrication d'un objet par mois et par groupe sédentaire (modulée par la compétence artisanat), 0 à 1.
  "chanceFabricationParMois": 0.5,

  // Probabilité de troc entre deux membres proches d'un même groupe, par mois, 0 à 1.
  "chanceTrocParMois": 0.4,

  // Usure d'un objet par mois d'utilisation (0 à 1 = fraction de valeur perdue).
  "usureObjetParMois": 0.01
}
