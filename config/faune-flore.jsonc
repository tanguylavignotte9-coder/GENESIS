{
  // ============================================================
  // FAUNE & FLORE — constantes écologiques.
  // Chaque animal est individuellement simulé ; les équilibres
  // proie-prédateur émergent, jamais régulés par code.
  // ============================================================

  // Effectif total d'animaux créés à la génération du monde (tirage entre min et max),
  // réparti sur les tuiles terrestres au prorata des poids de biome de chaque espèce.
  "effectifInitialMin": 1500,
  "effectifInitialMax": 4000,

  // Probabilité qu'une tuile fasse pousser sa végétation d'un cran un mois donné (0 à 1).
  "probabilitePousseVegetationParMois": 0.3,

  // Probabilité qu'une tuile perde de la biomasse un mois donné (0 à 1).
  "probabiliteDegradationVegetationParMois": 0.05,

  // Consommation de biomasse de la tuile par herbivore et par mois (échelle biomasse 0 à biomasseVegetationMax).
  "consommationVegetationParAnimalParMois": 3,

  // Multiplicateur global de reproduction de la faune (calibration équilibres proie-prédateur au banc).
  "multiplicateurReproductionFaune": 6,

  // Probabilité de capturer un animal sauvage proche d'un enclos, par mois (domestication), 0 à 1.
  "chanceCaptureParMois": 0.15,

  // Multiplicateur de reproduction des animaux domestiqués en enclos.
  "multiplicateurReproductionEnclos": 3,

  // Nourriture produite par animal domestiqué et par mois (lait, etc.), en unités.
  "productionAnimalParMois": 1,

  // Biomasse de végétation maximale d'une tuile (constante biologique du biome).
  "biomasseVegetationMax": 100,

  // Fraction de la carcasse restante qui disparaît chaque mois (décomposition), 0 à 1.
  "decroissanceCarcasseParMois": 0.15,

  // Perte de santé d'un animal par mois quand la température de sa tuile est sous le seuil de froid, en points.
  "perteSanteFroidFauneParMois": 6,

  // Température sous laquelle un animal souffre du froid, en degrés Celsius.
  "seuilFroidFauneCelsius": 0,

  // Perte de santé d'un animal par mois à faim maximale, en points (mort par famine émerge).
  "perteSanteFamineFauneParMois": 15,

  // Portée de chasse d'un prédateur, en tuiles (il détecte les proies dans ce rayon).
  "porteeChassePredateurTuiles": 3,

  // Probabilité qu'un prédateur tue une proie détectée, par mois (0 à 1).
  "chanceKillPredateurParMois": 0.5,

  // Rendement de cueillette par individu humain et par mois sur une tuile, en unités de nourriture.
  "rendementCueilletteParMois": 3,

  // Rendement de chasse par individu humain et par mois (avant probabilité de succès), en unités de nourriture.
  "rendementChasseParMois": 3,

  // Espèces réelles, peuplées selon le biome (poids par type de végétation :
  // Toundra, Taiga, Foret, Prairie, Savane, Jungle, Desert, Neige).
  // regime : herbivore | predateur | charognard.
  "especes": {
    "cerf": {
      "nom": "Cerf",
      "regime": "herbivore",
      "vitesseTuilesParMois": 6,
      "faimParMois": 6,
      "ageMaxAnnees": 18,
      "reproductionParMois": 0.1,
      "tailleCarcasse": 30,
      "poidsBiomes": { "Foret": 3, "Prairie": 2, "Taiga": 2, "Savane": 1 }
    },
    "bison": {
